# Copy to .env (or run `python scripts/generate_env.py`, which fills the secrets with random values). NEVER commit .env.
# Every secret below is intentionally EMPTY: there are no usable defaults.

# --- profile -------------------------------------------------------------------------------------------------
# production (default in Docker): all secrets required, Secure cookies, API docs off, no automatic scenario load unless AUTO_SEED_SCENARIO=1
# development: local convenience only - random per-process JWT secret if none is given, API docs on, scenario loaded into an empty database
APP_ENV=production

# --- secrets (required in production) --------------------------------------------------------------------------
# administrative database role (used once, to initialise the volume), the migration/owner role and the restricted application role
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
# First administrator, created only while the users table is empty. Remove the password from .env afterwards.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- network ---------------------------------------------------------------------------------------------------
# nginx: address range of a load balancer in FRONT of the web container, if any (default trusts nobody)
# TRUSTED_PROXY_CIDR=127.0.0.1/32
# Exact origins allowed to call the API from a browser (comma separated, no wildcards, https in production).
CORS_ORIGINS=http://localhost:8080

# --- data -----------------------------------------------------------------------------------------------------
# 1 = load the fictional illustrative scenario into an EMPTY database; 0 = you provide the data
AUTO_SEED_SCENARIO=1

# --- machine learning ------------------------------------------------------------------------------------------
# auto: the trained model drives forecasts only if its metadata records a "promoted" decision (default); ml: use it whenever it loads
# (visible fallback otherwise); statistical: never use it
FORECAST_MODEL_MODE=auto
# Optional out-of-band pins of the model files' SHA-256 (see docs/SECURITY.md); the model is refused if the file differs
ML_FORECAST_SHA256=
ML_SHORTAGE_SHA256=

# --- map tiles (optional — build-time Vite variables, not runtime) -----------------------------------------------
# Default: OpenStreetMap standard tiles (https://tile.openstreetmap.org/{z}/{x}/{y}.png).
# OSM REQUIRES: the nginx Referrer-Policy header must be 'strict-origin-when-cross-origin' (not 'no-referrer').
# OSM tile servers are best-effort / volunteer-funded. For production with guaranteed SLA, use a commercial provider
# (e.g. Stadia Maps, Jawg, Mapbox) and set VITE_TILE_URL + VITE_TILE_ATTRIBUTION at build time.
# These values are baked into the frontend bundle; they are not runtime secrets. Do not put API keys here
# if the tile provider embeds them in the URL — document them in a separate Dockerfile ARG / build secret instead.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors · fictional overlay

# --- local development without Docker (backend + `npm run dev`) -------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/logistics_dev
# VITE_PROXY_TARGET=http://localhost:8000
