# Rendered by the nginx image at start-up (envsubst): ${BACKEND_HOSTPORT}, ${NGINX_LOCAL_RESOLVERS} and ${TRUSTED_PROXY_CIDR} come from the environment.
server_tokens off;
client_max_body_size 64k;                 # every API request is small JSON
limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=login_per_ip:10m rate=10r/m;

server {
  listen 8080;
  server_name _;

  # Real client address. When another proxy or load balancer sits IN FRONT of this nginx (cloud platforms), list its address range in
  # TRUSTED_PROXY_CIDR and the client address is taken from X-Forwarded-For (only from that trusted peer); the API's rate limits and lock-outs then
  # work per client. Default 127.0.0.1/32 trusts nobody: the socket peer is the client and a client-supplied header is ignored.
  set_real_ip_from ${TRUSTED_PROXY_CIDR};
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;
  root /usr/share/nginx/html;
  index index.html;

  # The browser only talks to this origin; the API is proxied, so cookies are first-party and SameSite=Strict works.
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  # strict-origin-when-cross-origin (the browser default): sends the page origin as Referer on cross-origin requests.
  # OpenStreetMap's tile policy explicitly requires a valid HTTP Referer header from web pages; 'no-referrer' caused 403s.
  # Do NOT revert to 'no-referrer' without providing an alternative tile source.
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()" always;
  add_header Cross-Origin-Opener-Policy "same-origin" always;
  # script-src 'self': no inline or remote scripts. Map tiles come from tile providers (OSM by default); Leaflet needs inline style.
  # img-src allows https: for tile providers (OSM default; configurable via VITE_TILE_URL build arg without a config change here).
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

  # resolved at REQUEST time: nginx starts (and serves the SPA) even when the backend is down or restarting; /api then answers 502 and the UI shows its unavailable state
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location = /api/auth/login {
    limit_req zone=login_per_ip burst=5 nodelay;
    limit_req_status 429;
    set $backend_upstream http://${BACKEND_HOSTPORT};
    proxy_pass $backend_upstream;
    include /etc/nginx/proxy_common.conf;
  }

  location /api/ {
    limit_req zone=api_per_ip burst=60 nodelay;
    limit_req_status 429;
    set $backend_upstream http://${BACKEND_HOSTPORT};
    proxy_pass $backend_upstream;
    include /etc/nginx/proxy_common.conf;
  }

  # static assets are content-hashed by the build: cache them; never cache the HTML shell
  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; add_header X-Content-Type-Options "nosniff" always; try_files $uri =404; }
  location / {
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    # See comment above: strict-origin-when-cross-origin is required by the OSM tile usage policy.
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    try_files $uri /index.html;
  }
}
