{
  "seed": 42,
  "split": {"train": 0.70, "val": 0.15, "test": 0.15, "note": "chronological; test is evaluated once, after model selection on validation"},
  "sampling": {"train_rows": 400000, "val_rows": 120000, "rf_train_rows": 150000, "test_origin_stride": 13},
  "lightgbm": {
    "grid": {"num_leaves": [15, 31, 63], "objective": ["regression", "regression_l1"]},
    "fixed": {"learning_rate": 0.05, "n_estimators": 1500, "min_child_samples": 200, "feature_fraction": 0.8,
              "bagging_fraction": 0.8, "bagging_freq": 1, "lambda_l2": 1.0, "n_jobs": 1, "verbose": -1},
    "early_stopping_rounds": 50
  },
  "random_forest": {"n_estimators": 100, "max_depth": 14, "min_samples_leaf": 50, "max_features": 0.5, "n_jobs": 1},
  "interval": {"level": 0.8},
  "statistical_window_days": 110
}
